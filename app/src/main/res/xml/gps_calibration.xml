<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:singleLineTitle="false"
        app:title="@string/gps">

        <Preference
            android:summary="-"
            android:title="@string/location"
            app:icon="@drawable/satellite"
            app:key="@string/pref_holder_location"
            app:singleLineTitle="false" />

        <Preference
            android:title="@string/request_permission"
            app:iconSpaceReserved="false"
            app:isPreferenceVisible="false"
            app:key="@string/pref_gps_request_permission"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="@string/pref_auto_location"
            app:singleLineTitle="false"
            app:title="@string/pref_auto_location_title" />

        <com.kylecorry.trail_sense.shared.views.CoordinatePreference
            app:iconSpaceReserved="false"
            app:key="@string/pref_gps_override">
        </com.kylecorry.trail_sense.shared.views.CoordinatePreference>

        <ListPreference
            android:dependency="@string/pref_auto_location"
            app:defaultValue="4"
            app:iconSpaceReserved="false"
            app:key="@string/pref_gps_power_usage"
            app:singleLineTitle="false"
            app:title="@string/pref_gps_power_usage_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:dependency="@string/pref_auto_location"
            app:defaultValue="2"
            app:iconSpaceReserved="false"
            app:key="@string/pref_gps_accuracy_requirement"
            app:singleLineTitle="false"
            app:title="@string/pref_gps_accuracy_requirement_title"
            app:useSimpleSummaryProvider="true" />

        <SeekBarPreference
            android:dependency="@string/pref_auto_location"
            android:max="100"
            app:defaultValue="0"
            app:iconSpaceReserved="false"
            app:key="@string/pref_gps_smoothing"
            app:min="0"
            app:seekBarIncrement="1"
            app:singleLineTitle="false"
            app:title="@string/smoothing" />

        <Preference
            android:title="@string/clear_cache"
            android:dependency="@string/pref_auto_location"
            app:iconSpaceReserved="false"
            app:key="@string/pref_gps_clear_cache"
            app:singleLineTitle="false" />

    </PreferenceCategory>

</PreferenceScreen>
