<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Outlined"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="@android:color/transparent">

        <FrameLayout
            android:id="@+id/photo_upload_image_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/photo_upload_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/photo_upload_menu_button"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                app:icon="@drawable/ic_menu_dots" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/photo_upload_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            tools:visibility="gone">

            <Button
                android:id="@+id/photo_upload_take_photo_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/take_photo" />

            <Button
                android:id="@+id/photo_upload_select_photo_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/select_from_gallery" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</merge>
